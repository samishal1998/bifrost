---
// Starlight's site title plus a "Docs" link beside it: the header row is the only place
// that stays visible at every width, including the splash landing page (no sidebar menu there).
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const { hasSidebar } = Astro.locals.starlightRoute; // false on splash pages (landing, 404)
const href = import.meta.env.BASE_URL.replace(/\/$/, '') + '/installation/';
---

<Default />
<a {href} class="bf-docs-link" aria-current={hasSidebar ? 'true' : undefined}>Docs</a>

<style>
	.bf-docs-link {
		align-self: center;
		flex-shrink: 0;
		margin-inline-start: var(--sl-nav-gap);
		padding: 0.25rem 0.375rem;
		border-block-end: 2px solid transparent;
		color: var(--sl-color-gray-1);
		font-weight: 600;
		text-decoration: none;
	}
	.bf-docs-link:hover {
		color: var(--bf-nav-hover);
	}
	.bf-docs-link[aria-current] {
		color: var(--sl-color-text-accent);
		border-block-end-color: currentColor;
	}
	.bf-docs-link:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: -2px;
		border-radius: 0.25rem;
	}
</style>
